% Implement arithmetic operations, Factorial, and Fibonacci Series using recursion

% 1. BASIC ARITHMETIC OPERATIONS
calculate(A, B, Sum, Diff, Prod, Div, Mod) :-
    Sum  is A + B,
    Diff is A - B,
    Prod is A * B,
    Div  is A / B,
    Mod  is A mod B.

% 2. FACTORIAL
%    factorial(N, Result)
% Base Case
factorial(0, 1) :- !.

% Recursive Step
factorial(N, Result) :-
    N > 0,
    N1 is N - 1,
    factorial(N1, SubResult),
    Result is N * SubResult.

% 3. FIBONACCI
%    a) Finding N-th Fibonacci number: fibonacci(N, Result)
%    b) Generating Fibonacci series up to N terms: fib_series(N, Series)

% Base Cases for N-th Fibonacci
fibonacci(0, 0) :- !.
fibonacci(1, 1) :- !.

% Recursive Step for N-th Fibonacci
fibonacci(N, Result) :-
    N > 1,
    N1 is N - 1,
    N2 is N - 2,
    fibonacci(N1, F1),
    fibonacci(N2, F2),
    Result is F1 + F2.

% Helper to generate full series as a list from 0 to N-1
fib_series(N, Series) :-
    N > 0,
    N1 is N - 1,
    generate_fib_list(0, N1, Series).

generate_fib_list(Current, Max, [Val | Rest]) :-
    Current =< Max,
    fibonacci(Current, Val),
    Next is Current + 1,
    generate_fib_list(Next, Max, Rest).
generate_fib_list(Current, Max, []) :-
    Current > Max.

% Query and Output of Arithmetic Operations 
calculate(15, 4, Sum, Diff, Prod, Div, Mod).
Sum = 19,
Diff = 11,
Prod = 60,
Div = 3.75,
Mod = 3.

%Query and Output for Factorial Number 
factorial(5, Result).
Result = 120.

% Query and Output for Fibonacci Numbers
fib_series(8, Series).
Series = [0, 1, 1, 2, 3, 5, 8, 13].

